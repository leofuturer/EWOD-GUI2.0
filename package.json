  "scripts": {
  "start": "GENERATE_SOURCEMAP=false NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
  "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
  "test": "NODE_OPTIONS=--openssl-legacy-provider react-scripts test",
  "eject": "react-scripts eject",
  "lint": "yarn run eslint \"src/**/*.js\" \"src/**/*.jsx\" \"cypress/**/*.js\"",
  "postinstall": "patch-package",
  "serve": "NODE_OPTIONS=--openssl-legacy-provider yarn build && serve -s build",
  "cy:run": "cypress run",
  "cy:open": "cypress open",
  "e2e": "concurrently \"BROWSER=none yarn start\" \"wait-on http://localhost:3000 && cypress run\" --kill-others --success first",
  "e2e-gui": "concurrently \"BROWSER=none yarn start\" \"wait-on http://localhost:3000 && cypress open\" --kill-others --success first"
},
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "overrides": {
    "react-zoom-pan-pinch": {
      "generateSourceMap": false
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^6.0.2",
    "cypress": "8.2.0",
    "eslint": "^9.13.0",
